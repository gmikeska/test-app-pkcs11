APP_HSM_15_LABEL=asterism-pkcs11-app-15
APP_HSM_15_PIN=app-pin-0015
APP_HSM_15_SO_PIN=app-so-pin-0015

# Default federation: 3-of-3 using HSMs 1, 2, 3.
# APP_FED_SIGNERS selects which APP_HSM_{N} tokens form the initial
# federation (1-based indices, comma-separated). The full HSM pool
# remains available for migration tools.
APP_FED_THRESHOLD=3
APP_FED_SIGNERS=1,2,3

# =============================================================================
# Per-token BIP-39 mnemonics (read by the dev shim)
# =============================================================================
DEV_HSM_CONFIG=dev-hsm.toml
ELEMENTS_CHAIN_BACKEND=esplora
ELEMENTS_ESPLORA_URL=https://enterprise.blockstream.info/liquidtestnet/api
