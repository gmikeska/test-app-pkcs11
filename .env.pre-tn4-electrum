# Asterism test-app-pkcs11 — Development Environment
#
# Customer-facing webapp. Each user gets a 3-of-3 HSM-backed Bitcoin wallet
# at their own BIP-48 account index; every spend is signed by all 3 emulated
# HSMs server-side and broadcast immediately.

# =============================================================================
# Web server
# =============================================================================
APP_HOST=127.0.0.1
APP_PORT=8095
# 64-byte (hex) secret for signing session cookies. Replace before deploying
# anything resembling production.
APP_SESSION_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

RUST_LOG=test_app_pkcs11=debug,asterism=debug,asterism_pkcs11=debug,tower_http=info,sqlx=warn

# =============================================================================
# PostgreSQL
# =============================================================================
DATABASE_URL=postgres://asterism:asterism@host.docker.internal:5544/asterism_pkcs11

# =============================================================================
# Bitcoin Core RPC (regtest via Docker)
# =============================================================================
BITCOIN_RPC_USER=liquidregbtc
BITCOIN_RPC_PASSWORD=liquidregbtcpass
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=19443
BITCOIN_NETWORK=testnet
BITCOIN_WALLET_NAME=asterism-pkcs11-regtest

# --- Chain backend selector ---------------------------------------------------
# Which backend to use for chain sync AND broadcast:
#   rpc     = Bitcoin Core JSON-RPC (uses BITCOIN_RPC_* above)   [default]
#   esplora = nodeless Blockstream Esplora HTTP (uses APP_ESPLORA_URL below)
#   waterfalls = nodeless Blockstream Esplora HTTP with one query per descriptor (uses APP_ESPLORA_URL below)
# Note: esplora needs a PUBLIC network (e.g. signet) — not regtest. To use it,
# set APP_CHAIN_BACKEND=esplora AND switch BITCOIN_NETWORK to signet.
APP_CHAIN_BACKEND=esplora
APP_ESPLORA_URL=https://enterprise.blockstream.info/testnet/api

ESPLORA_CLIENT_ID=716ba742-66b7-424c-9600-5a26fecf0a8b
ESPLORA_CLIENT_SECRET=8HkiwBIqy4gJFvQppW2PbJk4F0BJjLI4
# =============================================================================
# Elements RPC (regtest via Docker)
# =============================================================================
ELEMENTS_RPC_USER=elements
ELEMENTS_RPC_PASSWORD=elementspass
ELEMENTS_RPC_HOST=host.docker.internal
ELEMENTS_RPC_PORT=18884
ELEMENTS_NETWORK=liquidtestnet

# BIP-48 coin-type for the customer wallet derivation path
# (m/48'/{coin}'/{account_idx}'/2'). Use 0 for `bitcoin`, 1 for everything
# else (testnet / signet / regtest). Optional; defaulted from BITCOIN_NETWORK.
APP_BIP48_COIN_INDEX=1

# =============================================================================
# PKCS#11 dev shim (libemvault_dev_hsm.so)
# =============================================================================
PKCS11_LIB=../libemvault_dev_hsm/target/release/libemvault_dev_hsm.so

# Backing SoftHSM 2 library + config — read by the shim, not by this app.
SOFTHSM2_LIB=/usr/lib/softhsm/libsofthsm2.so
SOFTHSM2_CONF=/home/agent/softhsm2/softhsm2.conf

# --- App-dedicated federation HSMs (3-of-3) ---------------------------------
APP_HSM_1_LABEL=asterism-pkcs11-app-1
APP_HSM_1_PIN=app-pin-0001
APP_HSM_1_SO_PIN=app-so-pin-0001

APP_HSM_2_LABEL=asterism-pkcs11-app-2
APP_HSM_2_PIN=app-pin-0002
APP_HSM_2_SO_PIN=app-so-pin-0002

APP_HSM_3_LABEL=asterism-pkcs11-app-3
APP_HSM_3_PIN=app-pin-0003
APP_HSM_3_SO_PIN=app-so-pin-0003

APP_HSM_4_LABEL=asterism-pkcs11-app-4
APP_HSM_4_PIN=app-pin-0004
APP_HSM_4_SO_PIN=app-so-pin-0004

# --- Automated-testing HSMs (5–15) -------------------------------------------
# HSMs 1–4 are for manual testing; 5–15 are reserved for automated test
# harnesses. Use reset-test-hsms.sh to wipe 5–15 without touching 1–4.

APP_HSM_5_LABEL=asterism-pkcs11-app-5
APP_HSM_5_PIN=app-pin-0005
APP_HSM_5_SO_PIN=app-so-pin-0005

APP_HSM_6_LABEL=asterism-pkcs11-app-6
APP_HSM_6_PIN=app-pin-0006
APP_HSM_6_SO_PIN=app-so-pin-0006

